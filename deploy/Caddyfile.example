# Add to /etc/caddy/Caddyfile on the VPS, then: sudo systemctl reload caddy
elnino.example.com {
	encode zstd gzip

	# Security headers (the app loads no third-party resources).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self'"
		-Server
	}

	reverse_proxy 127.0.0.1:8080
}
