# Copy to ~/.config/elnino-relay.env on the relay box.
ELNINO_BIN=$HOME/.local/bin/elnino
DATA_DIR=$HOME/.local/share/elnino-relay
CONTACT=you@example.com
# user@host of the VPS, reachable with ssh from this box without a password prompt.
VPS=moc0@vps.example.com
# Inbox directory on the VPS (the one compose mounts at /inbox).
INBOX=/opt/el-nino/inbox
# Optional: a dedicated key instead of your usual ones. If its authorized_keys entry
# uses rrsync (see README), set INBOX= (empty): rrsync roots paths at the inbox.
#SSH_KEY=$HOME/.ssh/elnino-relay
